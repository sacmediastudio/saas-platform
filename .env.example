# Copia este archivo a .env y completa los valores reales.

# Cadena de conexión a PostgreSQL. En local, puedes usar Docker:
# docker run --name saas-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_platform"

# Secreto para firmar el JWT de sesión. Genera uno real con:
# openssl rand -base64 32
JWT_SECRET="cambia-esto-por-un-secreto-real"

# Secreto para las sesiones del panel de administración (/admin) — a
# propósito separado del JWT_SECRET de arriba, para que un token de un
# lado nunca sirva del otro. Si lo dejas vacío, usa JWT_SECRET como
# respaldo, pero lo ideal es generar uno propio:
# openssl rand -base64 32
ADMIN_JWT_SECRET="cambia-esto-tambien-por-otro-secreto-real"

# Claves de Stripe (modo test). Se usan en el próximo paso cuando
# conectemos el billing real.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# API key de Resend (https://resend.com), para enviar el correo real con
# el código de verificación al crear una cuenta. Sin esto configurado,
# el código se imprime en los logs del servidor en vez de enviarse por
# correo — funciona para probar, pero no es apto para usuarios reales.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Zertoo <onboarding@resend.dev>"

# Integración con Google Calendar (módulo de Citas) — permite que cada
# negocio conecte su propio Google Calendar y cada cita confirmada se
# agregue ahí automáticamente. Sin esto configurado, el botón "Conectar"
# en /dashboard/bookings muestra un aviso de que no está disponible aún,
# pero el resto de la plataforma sigue funcionando normal.
#
# Cómo conseguir estos valores:
# 1. Ve a https://console.cloud.google.com/ y crea un proyecto (o usa uno existente)
# 2. Busca "Google Calendar API" en la biblioteca de APIs y actívala
# 3. Ve a "APIs y servicios" -> "Pantalla de consentimiento OAuth":
#    - Tipo de usuario: Externo
#    - Completa nombre de la app, correo de soporte, logo (opcional)
#    - En "Scopes" agrega: .../auth/calendar.events y .../auth/userinfo.email
#    - Mientras la app esté en modo "Prueba" (Testing), solo los correos
#      que agregues como "Usuarios de prueba" van a poder conectar —
#      para que cualquiera pueda hacerlo, hay que publicarla (Google
#      puede pedir verificación si usas scopes sensibles)
# 4. Ve a "Credenciales" -> "Crear credenciales" -> "ID de cliente de OAuth"
#    - Tipo de aplicación: Aplicación web
#    - En "URI de redireccionamiento autorizados" agrega exactamente:
#      https://tudominio.com/api/integrations/google-calendar/callback
#      (y también http://localhost:3000/api/integrations/google-calendar/callback para probar en local)
# 5. Copia el "ID de cliente" y el "Secreto del cliente" que te da
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Debe ser EXACTAMENTE la misma URL que registraste como "URI de
# redireccionamiento autorizado" en el paso 4 — si no coincide letra por
# letra (incluyendo http/https), Google rechaza la conexión.
GOOGLE_REDIRECT_URI="https://tudominio.com/api/integrations/google-calendar/callback"
