# Copia este archivo a .env y completa los valores reales.

# Cadena de conexión a PostgreSQL. En local, puedes usar Docker:
# docker run --name saas-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_platform"

# Secreto para firmar el JWT de sesión. Genera uno real con:
# openssl rand -base64 32
JWT_SECRET="cambia-esto-por-un-secreto-real"

# Claves de Stripe (modo test). Se usan en el próximo paso cuando
# conectemos el billing real.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
