// Esquema multi-tenant: casi todas las tablas cuelgan de Tenant vía tenantId.
// El aislamiento entre negocios se hace a nivel de fila (row-level), no de
// base de datos separada. Ver lib/tenant.ts para cómo se aplica en cada query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  RESTAURANT
  SMALL_BUSINESS
  SMARTLINK
}

enum Plan {
  STARTER
  PRO
  BUSINESS
}

enum UserRole {
  OWNER
  STAFF
}

enum MenuItemStatus {
  AVAILABLE
  SOLD_OUT
  SEASONAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REPORTED
}

model Tenant {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  businessType     BusinessType
  // Módulos activos de verdad. businessType queda como el "módulo con
  // el que empezó" (se sigue usando para el signup y como valor por
  // defecto), pero el acceso real a cada dashboard/página pública se
  // decide con este array — así un negocio puede tener Menú + Smartlink
  // a la vez, por ejemplo. Ver lib/modules.ts.
  enabledModules   BusinessType[] @default([])
  plan             Plan         @default(STARTER)
  stripeCustomerId String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Perfil público del negocio (usado en /menu/[slug] y /book/[slug])
  logoUrl       String?
  heroImageUrl  String?
  heroTagline   String?
  // Solo aplica al módulo de Menú: si se muestra la foto de cada plato
  // en la lista completa (no solo en Destacados). Default false para no
  // cambiar el comportamiento de negocios que ya estaban usando esto.
  menuShowPhotos Boolean @default(false)
  contactEmail  String?
  contactPhone  String?
  address       String?
  currency      String  @default("USD")
  themeBgColor  String  @default("#ffffff")
  themeTextColor String @default("#002D09")
  buttonColor      String @default("#E7FF00")
  buttonTextColor  String @default("#002D09")

  // Solo aplica al módulo de Citas: minutos de "colchón" que se dejan
  // libres después de cada cita antes de que se pueda reservar la
  // siguiente (limpieza, preparación, etc).
  bufferMinutes Int @default(15)
  // Zona horaria real del negocio (identificador IANA, ej. "America/Aruba").
  // Todo el cálculo de horario de atención, choques de citas, y el
  // calendario del dashboard se hace en base a esta — nunca en base a
  // la zona horaria del servidor (Railway corre en UTC), que es lo que
  // causaba que algunas citas no aparecieran bien en el calendario.
  timezone String @default("America/Aruba")

  // El panel de admin puede suspender una cuenta (ej. impago, abuso).
  // Mientras esté en true, el dashboard de ese negocio queda bloqueado.
  suspended Boolean @default(false)

  users          User[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  services       Service[]
  staffMembers   StaffMember[]
  availabilityBlocks AvailabilityBlock[]
  bookings       Booking[]
  reviews        Review[]
  smartLinkItems SmartLinkItem[]
  pageViews      PageView[]
  businessHours  BusinessHours[]
  externalReviewLinks ExternalReviewLink[]
  faqItems FaqItem[]
  googleCalendarConnection GoogleCalendarConnection?
  subscription   Subscription?

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())

  // Default en `true` a propósito: así las cuentas que ya existían antes
  // de este campo no quedan bloqueadas sin querer. El signup nuevo
  // sobrescribe esto a `false` explícitamente para las cuentas que sí
  // deben verificar su correo.
  emailVerified              Boolean   @default(true)
  verificationCode           String?
  verificationCodeExpiresAt  DateTime?
  verificationCodeSentAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

// ---------- Módulo Menú ----------

model MenuCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  // Traducción manual opcional al inglés (no automática — la escribe el
  // dueño, para no depender de un servicio de traducción de pago y para
  // no arriesgar traducciones incorrectas de ingredientes/alérgenos).
  nameEn    String?
  sortOrder Int      @default(0)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([tenantId])
  @@map("menu_categories")
}

model MenuItem {
  id          String         @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String
  description String?
  // Traducción manual opcional de la descripción — mismo criterio que
  // MenuCategory.nameEn. El nombre del plato nunca se traduce (puede
  // ser cualquier cosa: una marca, un plato regional, etc.).
  descriptionEn String?
  price       Decimal        @db.Decimal(10, 2)
  imageUrl    String?
  status      MenuItemStatus @default(AVAILABLE)
  featured    Boolean        @default(false)
  allergens   String[]       @default([])
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@map("menu_items")
}

// ---------- Módulo Bookings ----------

model StaffMember {
  id       String @id @default(cuid())
  tenantId String
  name     String

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services           Service[]
  bookings           Booking[]
  availabilityBlocks AvailabilityBlock[]

  @@index([tenantId])
  @@map("staff_members")
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  tenantId  String
  staffId   String?
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffMember? @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@index([tenantId, startTime])
  @@map("availability_blocks")
}

model Service {
  id              String  @id @default(cuid())
  tenantId        String
  staffId         String?
  name            String
  description     String?
  imageUrl        String?
  durationMinutes Int
  price           Decimal @db.Decimal(10, 2)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff    StaffMember? @relation(fields: [staffId], references: [id])
  bookings Booking[]

  @@index([tenantId])
  @@map("services")
}

model Booking {
  id            String        @id @default(cuid())
  tenantId      String
  serviceId     String
  staffId       String?
  customerName  String
  customerEmail String
  customerPhone String?
  datetime      DateTime
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  // Si el negocio tiene Google Calendar conectado, acá queda el id del
  // evento creado allá — para poder borrarlo si la cita se cancela.
  googleEventId String?

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id])
  staff   StaffMember? @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@index([tenantId, datetime])
  @@map("bookings")
}

// ---------- Módulo Reviews (transversal) ----------

model Review {
  id           String       @id @default(cuid())
  tenantId     String
  reviewerName String
  rating       Int // 1-5
  comment      String?
  source       String       @default("manual") // qr | booking | manual
  status       ReviewStatus @default(PUBLISHED)
  createdAt    DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("reviews")
}

enum SmartLinkType {
  WEBSITE
  WHATSAPP
  PHONE
  INSTAGRAM
  FACEBOOK
  TIKTOK
  TWITTER
  YOUTUBE
  LINKEDIN
  MAPS
  VCARD
  CUSTOM
}

model SmartLinkItem {
  id        String        @id @default(cuid())
  tenantId  String
  type      SmartLinkType
  label     String
  // Para WHATSAPP: solo dígitos (se arma el link wa.me al mostrarlo).
  // Para PHONE: número tal cual (se arma el link tel: al mostrarlo).
  // Para VCARD: no se usa — el archivo .vcf se arma con los datos de
  // contacto del negocio (Ajustes), así que puede ir vacío.
  // Para el resto: una URL completa que se usa directo como href.
  value      String?
  clickCount Int      @default(0)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("smartlink_items")
}

// Horario de atención semanal recurrente — hasta 7 filas por negocio
// (una por día de semana, 0=domingo...6=sábado). Si un día no tiene
// fila, se asume cerrado ese día. Solo aplica al módulo de Citas.
model BusinessHours {
  id        String  @id @default(cuid())
  tenantId  String
  dayOfWeek Int
  isOpen    Boolean @default(true)
  startTime String  @default("09:00")
  endTime   String  @default("18:00")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@map("business_hours")
}

// Links a plataformas externas de reseñas (Google, TripAdvisor, Yelp,
// etc.) que el negocio puede agregar y activar/desactivar cuando
// quiera, sin borrar la configuración. Se muestran en /review/[slug]
// junto al formulario de reseña interno.
enum ReviewPlatform {
  GOOGLE
  TRIPADVISOR
  YELP
  FACEBOOK
  CUSTOM
}

model ExternalReviewLink {
  id        String         @id @default(cuid())
  tenantId  String
  platform  ReviewPlatform
  label     String
  url       String
  enabled   Boolean        @default(true)
  sortOrder Int            @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("external_review_links")
}

// Conexión OAuth de un negocio con su Google Calendar — uno por
// negocio (@unique). Los tokens se guardan acá; se refrescan solos
// cuando expiran (ver lib/google-calendar.ts).
model GoogleCalendarConnection {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  connectedEmail String?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

// FAQ simple (sin IA) — el negocio escribe preguntas y respuestas fijas,
// se muestran como un chat flotante en sus 3 páginas públicas. No hay
// costo variable de por medio, a diferencia de un chatbot con IA real.
model FaqItem {
  id        String   @id @default(cuid())
  tenantId  String
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("faq_items")
}

enum PageViewKind {
  MENU
  BOOK
  LINK
}

model PageView {
  id        String       @id @default(cuid())
  tenantId  String
  kind      PageViewKind
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, createdAt])
  @@map("page_views")
}

// ---------- Billing ----------

// ---------- Panel de administración de Zertoo ----------
// Completamente separado del modelo User (que son los dueños de cada
// negocio cliente). No hay signup público para esto — se crea con el
// script prisma/create-admin.ts.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

// Registro de cada acción sensible hecha desde /admin, para poder
// revisar después quién hizo qué y cuándo. Guardamos el email/nombre
// del admin y del tenant "planos" (no solo el id) para que el log siga
// siendo legible incluso si esa cuenta se borra más adelante.
model AdminActivityLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String // SUSPEND | UNSUSPEND | DELETE_TENANT | UPDATE_SUBSCRIPTION
  tenantId   String?
  tenantName String
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("admin_activity_log")
}

model Subscription {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  // Un Customer de Stripe por negocio — se reutiliza tanto para el
  // checkout como para el portal de facturación (así el negocio no
  // tiene que volver a poner su tarjeta cada vez).
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  plan                 Plan     @default(STARTER)
  status               String   @default("trialing") // trialing | active | past_due | canceled
  currentPeriodEnd     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  SubscriptionModuleItem[]

  @@map("subscriptions")
}

// Cada módulo activo y facturado por separado — se cobra la suma de
// los que el negocio tenga habilitados. stripeItemId es el id del
// "subscription item" real en Stripe, para poder agregar/quitar
// módulos de la suscripción existente sin tener que cancelarla y
// crear una nueva cada vez que el negocio activa/desactiva algo.
model SubscriptionModuleItem {
  id             String       @id @default(cuid())
  subscriptionId String
  module         BusinessType
  stripeItemId   String?
  createdAt      DateTime     @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, module])
  @@map("subscription_module_items")
}
