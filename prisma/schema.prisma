// Esquema multi-tenant: casi todas las tablas cuelgan de Tenant vía tenantId.
// El aislamiento entre negocios se hace a nivel de fila (row-level), no de
// base de datos separada. Ver lib/tenant.ts para cómo se aplica en cada query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  RESTAURANT
  SMALL_BUSINESS
  SMARTLINK
}

enum Plan {
  STARTER
  PRO
  BUSINESS
}

enum UserRole {
  OWNER
  STAFF
}

enum MenuItemStatus {
  AVAILABLE
  SOLD_OUT
  SEASONAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REPORTED
}

model Tenant {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  businessType     BusinessType
  // Se fija una sola vez, al crear la cuenta ("7 días gratis" de la
  // landing) — nunca se recalcula. Un negocio sin suscripción real de
  // Stripe y con esta fecha ya pasada está "fuera de prueba": puede
  // seguir viendo su dashboard (no lo dejamos encerrado sin poder
  // llegar a pagar), pero no puede activar módulos nuevos gratis.
  trialEndsAt      DateTime?
  // Módulos activos de verdad. businessType queda como el "módulo con
  // el que empezó" (se sigue usando para el signup y como valor por
  // defecto), pero el acceso real a cada dashboard/página pública se
  // decide con este array — así un negocio puede tener Menú + Smartlink
  // a la vez, por ejemplo. Ver lib/modules.ts.
  enabledModules   BusinessType[] @default([])
  plan             Plan         @default(STARTER)
  stripeCustomerId String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Perfil público del negocio (usado en /menu/[slug] y /book/[slug])
  logoUrl       String?
  heroImageUrl  String?
  heroTagline   String?
  // Solo aplica al módulo de Menú: si se muestra la foto de cada plato
  // en la lista completa (no solo en Destacados). Default false para no
  // cambiar el comportamiento de negocios que ya estaban usando esto.
  menuShowPhotos Boolean @default(false)
  contactEmail  String?
  contactPhone  String?
  address       String?
  currency      String  @default("USD")
  themeBgColor  String  @default("#ffffff")
  themeTextColor String @default("#002D09")
  buttonColor      String @default("#E7FF00")
  buttonTextColor  String @default("#002D09")
  // Color de fondo de las tarjetas del menú público — tanto de cada
  // categoría como de la sección de Destacados. Por defecto blanco,
  // para que se note contra el fondo si el negocio eligió un fondo
  // de otro color.
  menuCardColor String @default("#ffffff")

  // Solo aplica al módulo de Citas: minutos de "colchón" que se dejan
  // libres después de cada cita antes de que se pueda reservar la
  // siguiente (limpieza, preparación, etc).
  bufferMinutes Int @default(15)
  // Zona horaria real del negocio (identificador IANA, ej. "America/Aruba").
  // Todo el cálculo de horario de atención, choques de citas, y el
  // calendario del dashboard se hace en base a esta — nunca en base a
  // la zona horaria del servidor (Railway corre en UTC), que es lo que
  // causaba que algunas citas no aparecieran bien en el calendario.
  timezone String @default("America/Aruba")

  // Recordatorios de citas por WhatsApp — activado por defecto (reduce
  // ausencias), cada negocio puede apagarlo o cambiar cuántas horas antes.
  remindersEnabled     Boolean @default(true)
  reminderHoursBefore  Int     @default(24)

  // Programa de sellos/fidelidad simple — cada visita confirmada (cita o
  // reseña, según el módulo) suma un sello por correo del cliente. Sin
  // costo, sin app nueva — el correo que ya capturamos es el identificador.
  loyaltyEnabled      Boolean @default(false)
  loyaltyVisitsNeeded Int     @default(6)
  loyaltyReward       String  @default("Tu próxima visita es gratis")
  loyaltyCards        LoyaltyCard[]

  // "Postre gratis" (o cualquier premio) en el menú — captura nombre,
  // correo y WhatsApp de un cliente nuevo a cambio de un código de
  // canje que se le manda por WhatsApp. Solo aplica al módulo de Menú.
  menuLeadEnabled     Boolean @default(false)
  menuLeadButtonLabel String  @default("Postre gratis 🎁")
  menuLeadRewardText  String  @default("un postre gratis en tu próxima visita")
  menuLeads           MenuLead[]
  customers           Customer[]
  moduleActivationRequests ModuleActivationRequest[]

  // Pedidos desde el menú (pickup / delivery) — se paga al retirar o
  // recibir, sin pasarela de pago online por ahora. Pickup y delivery
  // se activan por separado porque no todo negocio ofrece ambos.
  orderingEnabled     Boolean @default(false)
  pickupEnabled       Boolean @default(true)
  deliveryEnabled     Boolean @default(false)
  deliveryFee         Float?
  minDeliveryAmount   Float?
  menuOrders          MenuOrder[]

  // El panel de admin puede suspender una cuenta (ej. impago, abuso).
  // Mientras esté en true, el dashboard de ese negocio queda bloqueado.
  suspended Boolean @default(false)

  users          User[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  services       Service[]
  staffMembers   StaffMember[]
  availabilityBlocks AvailabilityBlock[]
  bookings       Booking[]
  reviews        Review[]
  smartLinkItems SmartLinkItem[]
  pageViews      PageView[]
  businessHours  BusinessHours[]
  externalReviewLinks ExternalReviewLink[]
  faqItems FaqItem[]
  googleCalendarConnection GoogleCalendarConnection?
  subscription   Subscription?

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())

  // Default en `true` a propósito: así las cuentas que ya existían antes
  // de este campo no quedan bloqueadas sin querer. El signup nuevo
  // sobrescribe esto a `false` explícitamente para las cuentas que sí
  // deben verificar su correo.
  emailVerified              Boolean   @default(true)
  verificationCode           String?
  verificationCodeExpiresAt  DateTime?
  verificationCodeSentAt     DateTime?

  // Recuperación de contraseña — token largo (no un código corto), va
  // en un link por correo, mismo criterio de "cooldown" que arriba
  // para no facilitar spam de correos de reset.
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?
  passwordResetSentAt         DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

// ---------- Módulo Menú ----------

model MenuCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  // Traducción manual opcional al inglés (no automática — la escribe el
  // dueño, para no depender de un servicio de traducción de pago y para
  // no arriesgar traducciones incorrectas de ingredientes/alérgenos).
  nameEn    String?
  sortOrder Int      @default(0)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([tenantId])
  @@map("menu_categories")
}

model MenuItem {
  id          String         @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String
  description String?
  // Traducción manual opcional de la descripción — mismo criterio que
  // MenuCategory.nameEn. El nombre del plato nunca se traduce (puede
  // ser cualquier cosa: una marca, un plato regional, etc.).
  descriptionEn String?
  price       Decimal        @db.Decimal(10, 2)
  // Para platos que se venden por peso/tamaño (ej. pescado entero) —
  // cuando está activo, el menú público muestra "Preguntar"/"Ask" en
  // vez de un precio, y el plato queda afuera del carrito de pedidos
  // (no hay forma de calcular un total automático sin un precio real).
  // "price" sigue guardando algo (0 por defecto) pero no se usa/muestra
  // mientras esto esté activo.
  variablePrice Boolean      @default(false)
  imageUrl    String?
  status      MenuItemStatus @default(AVAILABLE)
  featured    Boolean        @default(false)
  allergens   String[]       @default([])
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addOns   MenuItemAddOn[]

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@map("menu_items")
}

// Extra opcional de un plato (papas, extra queso, etc.) — cada plato
// define los suyos, no son compartidos entre platos.
model MenuItemAddOn {
  id         String @id @default(cuid())
  menuItemId String
  name       String
  price      Float  @default(0) // puede ser 0 (gratis)
  sortOrder  Int    @default(0)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("menu_item_addons")
}

// ---------- Módulo Bookings ----------

model StaffMember {
  id       String @id @default(cuid())
  tenantId String
  name     String

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services           Service[]
  bookings           Booking[]
  availabilityBlocks AvailabilityBlock[]

  @@index([tenantId])
  @@map("staff_members")
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  tenantId  String
  staffId   String?
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  StaffMember? @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@index([tenantId, startTime])
  @@map("availability_blocks")
}

model Service {
  id              String  @id @default(cuid())
  tenantId        String
  staffId         String?
  name            String
  description     String?
  imageUrl        String?
  durationMinutes Int
  price           Decimal @db.Decimal(10, 2)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff    StaffMember? @relation(fields: [staffId], references: [id])
  bookings Booking[]

  @@index([tenantId])
  @@map("services")
}

model Booking {
  id            String        @id @default(cuid())
  tenantId      String
  serviceId     String
  staffId       String?
  customerName  String
  customerEmail String
  customerPhone String?
  datetime      DateTime
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  // Si el negocio tiene Google Calendar conectado, acá queda el id del
  // evento creado allá — para poder borrarlo si la cita se cancela.
  googleEventId String?
  // Marca cuándo se mandó el recordatorio por WhatsApp — null significa
  // que todavía no se ha mandado. Evita que el cron job lo mande dos veces.
  reminderSentAt DateTime?
  // Idioma que el cliente tenía seleccionado al reservar (es|en) — se usa
  // para elegir la variante correcta de la plantilla de WhatsApp.
  language String @default("es")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id])
  staff   StaffMember? @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@index([tenantId, datetime])
  @@map("bookings")
}

// ---------- Módulo Reviews (transversal) ----------

model Review {
  id           String       @id @default(cuid())
  tenantId     String
  reviewerName String
  customerEmail String? // opcional — si se da, alimenta el CRM de clientes
  rating       Int // 1-5
  comment      String?
  source       String       @default("manual") // qr | booking | manual
  status       ReviewStatus @default(PUBLISHED)
  createdAt    DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("reviews")
}

enum SmartLinkType {
  WEBSITE
  WHATSAPP
  PHONE
  INSTAGRAM
  FACEBOOK
  TIKTOK
  TWITTER
  YOUTUBE
  LINKEDIN
  MAPS
  VCARD
  CUSTOM
}

model SmartLinkItem {
  id        String        @id @default(cuid())
  tenantId  String
  type      SmartLinkType
  label     String
  // Para WHATSAPP: solo dígitos (se arma el link wa.me al mostrarlo).
  // Para PHONE: número tal cual (se arma el link tel: al mostrarlo).
  // Para VCARD: no se usa — el archivo .vcf se arma con los datos de
  // contacto del negocio (Ajustes), así que puede ir vacío.
  // Para el resto: una URL completa que se usa directo como href.
  value      String?
  clickCount Int      @default(0)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("smartlink_items")
}

// Horario de atención semanal recurrente — hasta 7 filas por negocio
// (una por día de semana, 0=domingo...6=sábado). Si un día no tiene
// fila, se asume cerrado ese día. Solo aplica al módulo de Citas.
model BusinessHours {
  id        String  @id @default(cuid())
  tenantId  String
  dayOfWeek Int
  isOpen    Boolean @default(true)
  startTime String  @default("09:00")
  endTime   String  @default("18:00")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@map("business_hours")
}

// Links a plataformas externas de reseñas (Google, TripAdvisor, Yelp,
// etc.) que el negocio puede agregar y activar/desactivar cuando
// quiera, sin borrar la configuración. Se muestran en /review/[slug]
// junto al formulario de reseña interno.
enum ReviewPlatform {
  GOOGLE
  TRIPADVISOR
  YELP
  FACEBOOK
  CUSTOM
}

model ExternalReviewLink {
  id        String         @id @default(cuid())
  tenantId  String
  platform  ReviewPlatform
  label     String
  url       String
  enabled   Boolean        @default(true)
  sortOrder Int            @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("external_review_links")
}

// Conexión OAuth de un negocio con su Google Calendar — uno por
// negocio (@unique). Los tokens se guardan acá; se refrescan solos
// cuando expiran (ver lib/google-calendar.ts).
model GoogleCalendarConnection {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  connectedEmail String?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

// FAQ simple (sin IA) — el negocio escribe preguntas y respuestas fijas,
// se muestran como un chat flotante en sus 3 páginas públicas. No hay
// costo variable de por medio, a diferencia de un chatbot con IA real.
model FaqItem {
  id        String   @id @default(cuid())
  tenantId  String
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("faq_items")
}

// Una "tarjeta" de sellos por cliente (identificado por correo) por
// negocio — no requiere que el cliente tenga cuenta ni app.
model LoyaltyCard {
  id              String   @id @default(cuid())
  tenantId        String
  customerEmail   String
  customerName    String?
  stamps          Int      @default(0)
  rewardsRedeemed Int      @default(0)
  lastVisitAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerEmail])
  @@map("loyalty_cards")
}

// Un cliente que reclamó el premio de "postre gratis" (o el que sea)
// desde el menú público — nombre/correo/WhatsApp, y un código corto que
// se le manda por WhatsApp para canjear en el local.
model MenuLead {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  email      String
  phone      String
  claimCode  String    @unique
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("menu_leads")
}

// Vista unificada de "quién es cliente de este negocio", alimentada
// automáticamente desde citas, reseñas (si dejaron correo), y el
// premio del menú — un registro por correo, no uno por cada
// interacción. Es la base para que el negocio (y el admin de Zertoo)
// puedan ver/exportar/contactar a sus clientes reales.
model Customer {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  name         String?
  phone        String?
  fromBooking  Boolean  @default(false)
  fromReview   Boolean  @default(false)
  fromMenuLead Boolean  @default(false)
  fromOrder    Boolean  @default(false)
  unsubscribed Boolean  @default(false)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("customers")
}

// Historial de campañas de email/WhatsApp mandadas desde el panel de
// admin de Zertoo — no es por negocio, es a nivel plataforma.
model CampaignLog {
  id            String   @id @default(cuid())
  adminEmail    String
  channel       String // email | whatsapp
  tenantFilter  String? // null = todos los negocios, o el id de uno específico
  subject       String?
  message       String
  recipientCount Int
  sentCount     Int
  failedCount   Int
  createdAt     DateTime @default(now())

  @@map("campaign_logs")
}

enum OrderFulfillment {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING // recién llegó, el negocio todavía no lo vio
  CONFIRMED // el negocio lo aceptó y lo está preparando
  READY // listo para retirar, o en camino si es delivery
  COMPLETED
  CANCELLED
}

// Un pedido hecho desde el menú público — se paga al retirar/recibir,
// no hay cobro online todavía (ver README para el porqué de esta
// decisión y cómo se ampliaría a pago real más adelante).
model MenuOrder {
  id              String           @id @default(cuid())
  tenantId        String
  customerName    String
  customerEmail   String
  customerPhone   String
  fulfillment     OrderFulfillment
  deliveryAddress String? // solo si fulfillment = DELIVERY
  notes           String?
  status          OrderStatus      @default(PENDING)
  // Idioma que el cliente tenía seleccionado al hacer el pedido —
  // mismo criterio que Booking.language, para mandarle la confirmación
  // por WhatsApp en el idioma correcto.
  language        String           @default("es")
  subtotal        Float
  deliveryFee     Float            @default(0)
  total           Float
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuOrderItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("menu_orders")
}

// Snapshot del plato al momento del pedido (nombre y precio propios,
// no una referencia en vivo) — así si el negocio cambia el precio del
// plato después, los pedidos viejos no se alteran retroactivamente.
model MenuOrderItem {
  id       String @id @default(cuid())
  orderId  String
  name     String
  price    Float
  quantity Int
  // Snapshot de los add-ons elegidos (nombre + precio de cada uno, tal
  // como estaban al momento del pedido) — guardado como JSON, igual
  // criterio que name/price: si el negocio cambia sus add-ons después,
  // los pedidos viejos no se alteran retroactivamente.
  addOns   Json?
  notes    String? // algo muy específico de esta línea, ej. "sin cebolla"

  order MenuOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("menu_order_items")
}

// Un negocio ya no puede activar un módulo nuevo con un clic — deja
// una solicitud acá, y un admin de Zertoo la revisa y activa a mano
// (conversación real antes de sumar un módulo pagado, en vez de un
// alta impulsiva que después complica una baja parcial).
model ModuleActivationRequest {
  id          String    @id @default(cuid())
  tenantId    String
  module      String // RESTAURANT | SMALL_BUSINESS | SMARTLINK
  status      String    @default("pending") // pending | approved | rejected
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("module_activation_requests")
}

enum PageViewKind {
  MENU
  BOOK
  LINK
}

model PageView {
  id        String       @id @default(cuid())
  tenantId  String
  kind      PageViewKind
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, createdAt])
  @@map("page_views")
}

// ---------- Billing ----------

// ---------- Panel de administración de Zertoo ----------
// Completamente separado del modelo User (que son los dueños de cada
// negocio cliente). No hay signup público para esto — se crea con el
// script prisma/create-admin.ts.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  // Verificación en dos pasos (TOTP, tipo Google Authenticator) — este
  // panel puede ver clientes de TODOS los negocios y mandar campañas
  // masivas, así que vale la pena la capa extra de protección.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  @@map("admin_users")
}

// Registro de cada acción sensible hecha desde /admin, para poder
// revisar después quién hizo qué y cuándo. Guardamos el email/nombre
// del admin y del tenant "planos" (no solo el id) para que el log siga
// siendo legible incluso si esa cuenta se borra más adelante.
model AdminActivityLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String // SUSPEND | UNSUSPEND | DELETE_TENANT | UPDATE_SUBSCRIPTION
  tenantId   String?
  tenantName String
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("admin_activity_log")
}

model Subscription {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  // Un Customer de Stripe por negocio — se reutiliza tanto para el
  // checkout como para el portal de facturación (así el negocio no
  // tiene que volver a poner su tarjeta cada vez).
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  plan                 Plan     @default(STARTER)
  status               String   @default("trialing") // trialing | active | past_due | canceled
  currentPeriodEnd     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  SubscriptionModuleItem[]

  @@map("subscriptions")
}

// Cada módulo activo y facturado por separado — se cobra la suma de
// los que el negocio tenga habilitados. stripeItemId es el id del
// "subscription item" real en Stripe, para poder agregar/quitar
// módulos de la suscripción existente sin tener que cancelarla y
// crear una nueva cada vez que el negocio activa/desactiva algo.
model SubscriptionModuleItem {
  id             String       @id @default(cuid())
  subscriptionId String
  module         BusinessType
  stripeItemId   String?
  createdAt      DateTime     @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, module])
  @@map("subscription_module_items")
}
